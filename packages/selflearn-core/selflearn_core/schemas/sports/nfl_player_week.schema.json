{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liddar12/SelfLearning/blob/main/packages/selflearn-core/selflearn_core/schemas/sports/nfl_player_week.schema.json",
  "title": "nfl.player_week",
  "description": "Sports task contract (S1) for task='nfl.player_week'. Mirrors selflearn_core.contracts_sports.SPORTS_TASKS['nfl.player_week']; the Python validator is the source of truth and a test keeps the required keys here equal to it. Horizon: kickoff -> stats final; horizon_s >= 1.",
  "type": "object",
  "required": [
    "id",
    "ts",
    "model_version",
    "task",
    "features",
    "prediction",
    "horizon_s"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "ts": {
      "type": "integer",
      "description": "unix seconds, prediction time; must be <= meta.kickoff_ts when present (no lookahead)"
    },
    "model_version": {
      "type": "string",
      "description": "the shipped rule, e.g. weekly_split_v2 | candidate | parlay_v2"
    },
    "task": {
      "const": "nfl.player_week"
    },
    "features": {
      "$ref": "#/$defs/features"
    },
    "prediction": {
      "$ref": "#/$defs/prediction"
    },
    "horizon_s": {
      "type": "integer",
      "minimum": 1,
      "description": "kickoff -> stats final; horizon_s >= 1"
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "cohort": {
      "type": [
        "string",
        "null"
      ],
      "description": "free text: position / week / tier"
    },
    "meta": {
      "type": "object",
      "description": "Measurement-only side channel. kickoff_ts (unix seconds) enables the no-lookahead check; market prices (market_prob, closing_line, ...) live here.",
      "properties": {
        "kickoff_ts": {
          "type": "integer"
        },
        "market_prob": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "$defs": {
    "features": {
      "type": "object",
      "required": [
        "position",
        "team",
        "opp",
        "week",
        "dvp_factor",
        "weather_factor",
        "venue_factor",
        "availability"
      ],
      "properties": {
        "position": {
          "type": "string",
          "description": "QB | RB | WR | TE | K | DST"
        },
        "team": {
          "type": "string",
          "description": "player's team"
        },
        "opp": {
          "type": "string",
          "description": "opponent"
        },
        "week": {
          "type": "integer",
          "description": "NFL week number"
        },
        "dvp_factor": {
          "type": "number",
          "description": "defense-vs-position multiplier"
        },
        "weather_factor": {
          "type": "number",
          "description": "weather multiplier"
        },
        "venue_factor": {
          "type": "number",
          "description": "venue multiplier (home/away/neutral)"
        },
        "availability": {
          "type": "string",
          "description": "availability status at ts (e.g. active | questionable | doubtful | out)"
        }
      },
      "description": "Point-in-time features known at ts. Market prices are NOT allowed here (keys implied_prob, market_prob, closing_line, moneyline, spread_line, kalshi, polymarket are rejected at any depth); put them under meta.",
      "additionalProperties": true
    },
    "prediction": {
      "type": "object",
      "required": [
        "points",
        "low",
        "high"
      ],
      "properties": {
        "points": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        }
      },
      "description": "points are league-priced PPR; low <= points <= high."
    },
    "outcome": {
      "type": "object",
      "required": [
        "points_ppr",
        "played"
      ],
      "properties": {
        "points_ppr": {
          "type": "number"
        },
        "played": {
          "type": "boolean"
        }
      },
      "description": "Realized payload (Outcome.realized) once the event is final. Unresolved events have no outcome at all."
    }
  }
}
