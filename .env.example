# Copy to .env (gitignored) and fill in. Never commit real values.
EIA_API_KEY=your-eia-open-data-key
POWER2026_ISO=ERCOT
# GRIDSTATUS_MODE=oss        # 'oss' (free lib) or 'hosted' (needs GRIDSTATUS_API_KEY)
# GRIDSTATUS_API_KEY=...

# Hosted learning is explicitly default-off. Do not enable before the reviewed
# staging/migration/release checks in docs/architecture/2026-10-15/CAPTURE_ROLLOUT.md.
SELFLEARN_JOURNAL_BACKEND=disabled
SELFLEARN_CAPTURE_BACKEND=disabled
# SUPABASE_URL=https://your-approved-project.supabase.co
# SUPABASE_SECRET_KEY=server-only-secret
# Or remove SUPABASE_SECRET_KEY completely and select a supported legacy key:
# SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-jwt
# SELFLEARN_OPERATOR_TOKEN=distinct-owner-token-at-least-32-printable-characters
# SELFLEARN_NFL_INGEST_TOKEN=distinct-forecast-token-at-least-32-printable-characters
# SELFLEARN_NFL_OUTCOME_INGEST_TOKEN=distinct-outcome-token-at-least-32-printable-characters
# SELFLEARN_CAPTURE_EVIDENCE_BUCKET=reviewed-private-bucket
