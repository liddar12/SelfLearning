# Documented variable names. Use an approved environment/secret store.
# The automation tools never source .env. Never commit real values.
EIA_API_KEY=your-eia-open-data-key
POWER2026_ISO=ERCOT
# GRIDSTATUS_MODE=oss        # 'oss' (free lib) or 'hosted' (needs GRIDSTATUS_API_KEY)
# GRIDSTATUS_API_KEY=...

# Optional service configuration. Empty means absent, never "connected".
# Alpaca adapter defaults to paper; readiness does not place orders.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
